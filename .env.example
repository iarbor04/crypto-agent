# --- Telegram (сводки агента) ---
# Создать бота: @BotFather -> /newbot -> токен
TELEGRAM_BOT_TOKEN=
# ID канала (@my_channel) или чата. Для канала: добавить бота админом.
TELEGRAM_CHAT_ID=

# --- Защита cron-эндпоинта ---
# Любая строка. Запуск агента: POST /api/agent/run?secret=...
AGENT_SECRET=change-me

# --- ИИ-разбор токенов (ASCN Crypto API) ---
# Ключ: b2b.ascn.ai. Без него агент присылает сводку по своим метрикам,
# но без ончейна, новостей и ликвидаций от ИИ-ассистента.
# Внимание: один разбор токена идёт 3-6 минут, поэтому запросы уходят
# параллельно и только по токенам, где действительно что-то изменилось.
ASCN_API_KEY=
ASCN_MODEL=ascn_v1.2

# --- Рекомендуется: бесплатный demo-ключ CoinGecko ---
# Без ключа публичный API держит ~5-15 запросов в минуту и иногда отдаёт 429
# (тогда часть профилей токенов подтянется со второй попытки).
# Ключ бесплатный: coingecko.com -> Developers -> Demo API key, 30 запросов/мин.
COINGECKO_API_KEY=
